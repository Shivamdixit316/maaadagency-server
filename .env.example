# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://maaadagency.vercel.app

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_DNS_SERVERS=
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed ───────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@maaadagency.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EMPLOYEE_PASSWORD=Employee@12345

# ─── WhatsApp ───────────────────────────────────────────────────────────────
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DRY_RUN=true

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# ─── Smart auto-reply (AI) ──────────────────────────────────────────────────
# false = the existing rule-based bot, exactly as before. This is also a hard
# kill switch: the admin settings screen cannot turn AI on while this is false.
AI_ENABLED=false
# Only "anthropic" is supported for now.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high: lower is faster and cheaper; classification rarely needs more.
AI_EFFORT=low
# Answers below this confidence are not saved; the bot asks again instead.
AI_CONFIDENCE_THRESHOLD=0.75
# How many recent messages the AI sees for context.
AI_CONTEXT_MESSAGES=10
# Per-call timeout; on timeout the rule-based flow handles the message.
AI_TIMEOUT_MS=8000
